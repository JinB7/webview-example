{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // empty' | xargs -r -d '\\n' npx --no-install prettier --write --ignore-unknown"
          }
        ]
      }
    ]
  }
}
